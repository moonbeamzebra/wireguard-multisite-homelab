# ==============================================================================
# site-B.env -- Site B public configuration (git-tracked)
# Site B = "chalet"
#
# Usage:
#   source site-B.env && source secrets-B.env
#   sudo bash 06-network.sh   (or any other script)
#
# Pair with secrets-B.env (gitignored) for passwords and WireGuard keys.
# ==============================================================================

# -- Identity ------------------------------------------------------------------
export SITE=B
export SITE_NAME=chalet                  # used in VM names, DNS, motd
export SITE_LETTER=c                     # short prefix: c-router00, c-bastion
export SERVER00_HOSTNAME=${SITE_LETTER}-server00
export PRIMARY_DOMAIN=chalet.lab
export SECONDARY_DOMAIN=maison.lab

# -- Host physical interfaces --------------------------------------------------
export IF_LAN5=enx00e04c534458           # USB Ethernet dongle -> br-ext5 -> LAN5
export MAC_OF_IF_LAN5=$(echo "${IF_LAN5#enx}" | sed 's/../&:/g;s/:$//')
export IF_LAN10=enp1s0                   # RJ45 right -> br-ext10 -> LAN10 / default route
export IF_ISP=eno1                       # RJ45 left  -> br-isp  -> WAN / ISP modem

# -- Host bridge IP ------------------------------------------------------------
export IP_BR_EXT=10.1.10.2/24
export GW_BR_EXT=10.1.10.1

# -- Preseed (Debian host install) ---------------------------------------------
export PRESEED_HOSTNAME=${SERVER00_HOSTNAME}
export PRESEED_DOMAIN=${PRIMARY_DOMAIN}
export PRESEED_IF_LAN=wlp3s0             # WiFi interface name on GMKtec M7 Ultra
export PRESEED_IP=192.168.0.250          # Static IP during install (WiFi)
export PRESEED_NETMASK=255.255.255.0
export PRESEED_GW=192.168.0.1

# -- Host security -------------------------------------------------------------
export WIFI_SUBNET=192.168.86.0/24       # dev mode SSH access (13-host-hardening.sh)

# -- Bastion VM ----------------------------------------------------------------
export BASTION_VM_NAME=${SITE_LETTER}-bastion
export BASTION_HOSTNAME=${SITE_LETTER}-bastion
export NET_Bastion_eth0=lan-isp

# eth0 -- WAN (br-isp -> ISP modem)
# Valeurs du chalet
export BASTION_IP_eth0=192.168.40.252
export BASTION_GW_eth0=192.168.40.1
#export BASTION_IP_eth0=192.168.0.251
#export BASTION_GW_eth0=192.168.0.1
export BASTION_MASK_eth0=255.255.255.0

# eth1 -- DMZ /30 link toward router00
export BASTION_IP_eth1=10.1.1.1
export BASTION_MASK_eth1=255.255.255.252

# WireGuard
export WG_ADDR=10.0.0.2/30              # local wg0 IP
export WG_LISTEN_PORT=51830             # UDP port forwarded on ISP router to this bastion
export WG_ALLOWED_IPS=10.0.0.0/16,10.0.0.0/30

# Routes injected by wg-quick PostUp / PostDown
export ROUTE1_NET=10.1.0.0/16           # all local subnets -> via eth1 (router00)
export ROUTE1_GW=10.1.1.2              # router00 DMZ IP
export ROUTE2_NET=10.0.0.0/16           # remote site -> via wg0
export ROUTE2_GW=10.0.0.1              # remote bastion wg0 IP

# -- Router00 VM ---------------------------------------------------------------
export ROUTER00_VM_NAME=${SITE_LETTER}-router00
export ROUTER00_HOSTNAME=${SITE_LETTER}-router00

# eth0 -- DMZ /30 link toward bastion
export ROUTER00_IP_eth0=10.1.1.2
export ROUTER00_MASK_eth0=255.255.255.252
export ROUTER00_GW_eth0=10.1.1.1

# eth1 -- LAN10 (br-ext10, untagged)
export ROUTER00_IP_eth1=10.1.10.1
export ROUTER00_MASK_eth1=255.255.255.0
export LAN10_SUBNET=10.1.10.0/24
export REMOTE_LAN10_SUBNET=10.0.10.0/24

# eth2 -- OVS trunk (VLAN20 and VLAN30)
export ROUTER00_IP_eth2_20=10.1.20.1
export LAN20_SUBNET=10.1.20.0/24
export REMOTE_LAN20_SUBNET=10.0.20.0/24

export ROUTER00_IP_eth2_30=10.1.30.1
export LAN30_SUBNET=10.1.30.0/24
export REMOTE_LAN30_SUBNET=10.0.30.0/24

# eth3 -- LAN5 (br-ext5, USB dongle)
export ROUTER00_IP_eth3=10.1.5.1
export LAN5_SUBNET=10.1.5.0/24
export REMOTE_LAN5_SUBNET=10.0.5.0/24

# DHCP pools
export DHCP_LAN5_START=10.1.5.100
export DHCP_LAN5_END=10.1.5.200
export DHCP_LAN10_START=10.1.10.100
export DHCP_LAN10_END=10.1.10.200
export DHCP_VLAN20_START=10.1.20.100
export DHCP_VLAN20_END=10.1.20.200
export DHCP_VLAN30_START=10.1.30.100
export DHCP_VLAN30_END=10.1.30.200

# DNS forwarding to remote site
export DNS_REMOTE_DOMAIN=maison.lab
export DNS_REMOTE_SERVER=10.0.10.1
export DNS_REMOTE_REVERSE=0.10.in-addr.arpa
export DNS_REMOTE_REVERSE_SERVER=10.0.10.1

# iptables: sources accepted on router00 eth0 (DMZ interface)
export IPTABLES_ETH0_ACCEPT_1=10.0.0.0/16   # inter-site traffic via WireGuard
export IPTABLES_ETH0_ACCEPT_2=10.1.0.0/16   # local bastion and WG subnet

# Libvirt network names (defined by 07-libvirt-nets.sh)
export NET_eth0=lan-dmz
export NET_eth1_portgroup="lan-ext10,portgroup=lan10"
export NET_eth2_portgroup="lan-int,portgroup=trunk"
export NET_eth3_portgroup="lan-ext5,portgroup=lan5"

# Static DHCP reservations (injected into /etc/dnsmasq.d/static-dhcp.conf)
export DHCP_STATIC_HOSTS="\
      dhcp-host=b0:e4:d5:2f:28:09,c-nest-lan10,10.1.10.100
      dhcp-host=52:54:54:02:9b:88,c-k3s-agent-1,10.1.10.111
      dhcp-host=52:54:f0:fd:33:7c,c-k3s-agent-2,10.1.10.112
      dhcp-host=52:54:38:5a:d2:90,c-jellyfin,10.1.10.10"

# Static DNS host records (injected into /etc/dnsmasq.d/static-hosts.conf)
export DNS_STATIC="\
      host-record=c-server00.chalet.lab,10.1.10.2
      host-record=c-bastion-dmz.chalet.lab,c-bastion.chalet.lab,10.1.1.1
      host-record=c-bastion-isp.chalet.lab,192.168.0.251
      host-record=m-bastion-wg.maison.lab,10.0.0.1
      host-record=c-bastion-wg.chalet.lab,10.0.0.2
      host-record=m-router00-dmz.maison.lab,10.0.1.2
      host-record=c-router00-dmz.chalet.lab,10.1.1.2
      host-record=c-router00-lan5.chalet.lab,10.1.5.1
      host-record=c-router00-lan10.chalet.lab,c-router00.chalet.lab,10.1.10.1
      host-record=c-router00-vlan20.chalet.lab,10.1.20.1
      host-record=c-router00-vlan30.chalet.lab,10.1.30.1
      host-record=c-nest-lan10.chalet.lab,c-nest.chalet.lab,10.1.10.100
      host-record=c-jellyfin.chalet.lab,c-jellyfin,10.1.10.10"

# -- Demo VMs ------------------------------------------------------------------
export DEMO_VM_PREFIX=${SITE_LETTER}-demo
export DEMO_IP_PREFIX=10.1                # VM IPs: 10.1.<lan>.<host>

# -- Cloud images --------------------------------------------------------------
export ALPINE_IMAGE_URL="https://dl-cdn.alpinelinux.org/alpine/v3.23/releases/cloud"
export ALPINE_IMAGE_ORIGINAL_FILE_NAME="nocloud_alpine-3.23.4-x86_64-bios-cloudinit-r0.qcow2"
export ALPINE_EFFECTIVE_IMAGE_TO_USE="${ALPINE_IMAGE_ORIGINAL_FILE_NAME}--updated.qcow2"

export DEBIAN_IMAGE_URL="https://cloud.debian.org/images/cloud/trixie/latest"
export DEBIAN_IMAGE_ORIGINAL_FILE_NAME="debian-13-generic-amd64.qcow2"
export DEBIAN_EFFECTIVE_IMAGE_TO_USE="${DEBIAN_IMAGE_ORIGINAL_FILE_NAME}--updated.qcow2"

export NUT_UPS_NAME="cyberpower"
export NUT_USER="monuser"
export NUT_BATTERY_WARN=-1
