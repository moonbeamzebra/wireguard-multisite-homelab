# ==============================================================================
# site-specific-secrets.env.template -- Template for per-site secret files
#
# Copy and fill in once per site:
#   cp site-specific-secrets.env.template site-A-secrets.env
#   cp site-specific-secrets.env.template site-B-secrets.env
#
# These files are gitignored. Never commit them.
#
# Usage:
#   source site-A.env && source site-A-secrets.env && bash 08-create-bastion.sh
#   source site-B.env && source site-B-secrets.env && bash 08-create-bastion.sh
# ==============================================================================

# -- WireGuard -----------------------------------------------------------------
# This site's private key (wg genkey)
export WG_PRIVATE_KEY="REPLACE_WITH_THIS_SITE_PRIVATE_KEY"

# The other site's public key (wg pubkey < other-site.key)
export WG_PEER_PUBKEY="REPLACE_WITH_PEER_SITE_PUBLIC_KEY"

# The other site's WireGuard endpoint: public IP + forwarded UDP port
# Format: <public-ip>:<port>   e.g. 24.202.249.29:4441
export WG_PEER_ENDPOINT="REPLACE_WITH_PEER_PUBLIC_IP:PORT"

# -- SSH -----------------------------------------------------------------------
# Content of ~/.ssh/id_ed25519_lab-maison-chalet.pub (one line)
export LAB_SSH_PUBKEY="REPLACE_WITH_SSH_PUBLIC_KEY"

# -- Passwords (console access only -- SSH key auth is the primary method) ----
export LAB_PASSWORD="REPLACE_WITH_LAB_PASSWORD"
export ROOT_PASSWORD="REPLACE_WITH_ROOT_PASSWORD"

# -- Preseed (Debian install over WiFi) ----------------------------------------
export PRESEED_WIRELESS_ESSID="REPLACE_WITH_WIFI_SSID"
export PRESEED_WIRELESS_WPA="REPLACE_WITH_WIFI_PASSWORD"
