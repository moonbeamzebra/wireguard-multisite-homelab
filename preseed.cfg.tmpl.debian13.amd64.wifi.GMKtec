# preseed.cfg.tmpl -- Optimized for GMKtec M7 Ultra (Ryzen 6850U)

# -- Locale + Clavier ----------------------------------------------------------
d-i debian-installer/locale string en_US.UTF-8
d-i keyboard-configuration/xkb-keymap select us

######################################################################################
# -- Réseau (WI-FI Automatique) ------------------------------------------------
d-i netcfg/choose_interface select %%PRESEED_IF_LAN%%
d-i netcfg/wireless_show_essids select %%PRESEED_WIRELESS_ESSID%%
d-i netcfg/wireless_essid string %%PRESEED_WIRELESS_ESSID%%
d-i netcfg/wireless_security_type select wpa
d-i netcfg/wireless_wpa string %%PRESEED_WIRELESS_WPA%%

# Attente DHCP
d-i netcfg/use_autoconfig boolean true
d-i netcfg/dhcp_timeout string 60
d-i netcfg/dhcp_failed note
d-i netcfg/dhcp_options select Configure network manually
######################################################################################

d-i netcfg/get_hostname string %%PRESEED_HOSTNAME%%
d-i netcfg/get_domain string %%PRESEED_DOMAIN%%

# -- Miroir & Firmware ---------------------------------------------------------
d-i mirror/country string CA
d-i mirror/http/hostname string deb.debian.org
d-i mirror/http/directory string /debian
d-i mirror/http/proxy string
d-i hw-detect/load_firmware boolean true

# -- Horloge -------------------------------------------------------------------
d-i clock-setup/utc boolean true
d-i time/zone string America/Montreal
d-i clock-setup/ntp boolean true

# -- Partitionnement LVM (Cible NVMe) ------------------------------------------
# CHANGEMENT : /dev/sda -> /dev/nvme0n1
d-i partman-auto/disk string /dev/nvme0n1
d-i partman-auto/method string lvm
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-lvm/confirm boolean true
d-i partman-lvm/confirm_nooverwrite boolean true

d-i partman-auto/choose_recipe select custom-lvm
d-i partman-auto/expert_recipe string        \
  custom-lvm ::                              \
    512 512 512 fat32                        \
      $primary{ }                            \
      method{ efi }                          \
      format{ }                              \
    .                                        \
    1024 1024 1024 ext4                      \
      $primary{ }                            \
      $bootable{ }                           \
      method{ format }                       \
      format{ }                              \
      use_filesystem{ }                      \
      filesystem{ ext4 }                     \
      mountpoint{ /boot }                    \
    .                                        \
    100 1000 -1 ext4                         \
      $defaultignore{ }                      \
      $primary{ }                            \
      method{ lvm }                          \
      device{ /dev/nvme0n1 }                 \
      vg_name{ vg0 }                         \
    .                                        \
    20480 20480 20480 ext4                   \
      $lvmok{ }                              \
      in_vg{ vg0 }                           \
      lv_name{ lv-root }                     \
      method{ format }                       \
      format{ }                              \
      use_filesystem{ }                      \
      filesystem{ ext4 }                     \
      mountpoint{ / }                        \
    .                                        \
    51200 51200 51200 ext4                      \
      $lvmok{ }                              \
      in_vg{ vg0 }                           \
      lv_name{ lv-var }                      \
      method{ format }                       \
      format{ }                              \
      use_filesystem{ }                      \
      filesystem{ ext4 }                     \
      mountpoint{ /var }                     \
    .                                        \
    10240 10240 10240 ext4                   \
      $lvmok{ }                              \
      in_vg{ vg0 }                           \
      lv_name{ lv-tmp }                      \
      method{ format }                       \
      format{ }                              \
      use_filesystem{ }                      \
      filesystem{ ext4 }                     \
      mountpoint{ /tmp }                     \
    .                                        \
    102400 102400 102400 ext4                \
      $lvmok{ }                              \
      in_vg{ vg0 }                           \
      lv_name{ lv-kvm }                      \
      method{ format }                       \
      format{ }                              \
      use_filesystem{ }                      \
      filesystem{ ext4 }                     \
      mountpoint{ /var/lib/libvirt/images }  \
    .

d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true
d-i partman-basicfilesystems/no_swap boolean false

# -- Utilisateurs --------------------------------------------------------------
d-i passwd/root-login boolean true
d-i passwd/root-password password %%ROOT_PASSWORD%%
d-i passwd/root-password-again password %%ROOT_PASSWORD%%

d-i passwd/make-user boolean true
d-i passwd/user-fullname string lab
d-i passwd/username string lab
d-i passwd/user-password password %%LAB_PASSWORD%%
d-i passwd/user-password-again password %%LAB_PASSWORD%%
d-i passwd/user-groups string sudo

# -- Paquets -------------------------------------------------------------------
tasksel tasksel/first multiselect ssh-server, standard
d-i pkgsel/include string openssh-server sudo
d-i pkgsel/upgrade select full-upgrade
d-i pkgsel/update-policy select none

# -- GRUB ----------------------------------------------------------------------
d-i grub-installer/only_debian boolean true
# CHANGEMENT : Cible bootloader sur NVMe
d-i grub-installer/bootdev string /dev/nvme0n1

# -- Post-installation (Late Command) ------------------------------------------
d-i preseed/late_command string \
    in-target bash -c 'echo "auto wlp3s0" > /etc/network/interfaces.d/01-wifi.conf'; \
    in-target bash -c 'echo "iface wlp3s0 inet dhcp" >> /etc/network/interfaces.d/01-wifi.conf'; \
    in-target bash -c 'echo "    wpa-ssid %%PRESEED_WIRELESS_ESSID%%" >> /etc/network/interfaces.d/01-wifi.conf'; \
    in-target bash -c 'echo "    wpa-psk  %%PRESEED_WIRELESS_WPA%%" >> /etc/network/interfaces.d/01-wifi.conf'; \
    in-target bash -c 'echo "    dhcp-timeout 60" >> /etc/network/interfaces.d/01-wifi.conf'; \
    in-target chmod 600 /etc/network/interfaces.d/01-wifi.conf; \
    in-target sed -i '/wlp3s0/d' /etc/network/interfaces; \
    in-target sed -i '/wpa-ssid/d' /etc/network/interfaces; \
    in-target sed -i '/wpa-psk/d' /etc/network/interfaces; \
    in-target bash -c 'echo "lab ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/lab && chmod 440 /etc/sudoers.d/lab'; \
    in-target bash -c 'mkdir -p /home/lab/.ssh && chmod 700 /home/lab/.ssh'; \
    in-target bash -c 'echo "%%LAB_SSH_PUBKEY%%" > /home/lab/.ssh/authorized_keys'; \
    in-target bash -c 'chmod 600 /home/lab/.ssh/authorized_keys && chown -R lab:lab /home/lab/.ssh'; \
    in-target bash -c 'fallocate -l 2G /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon --priority 10 /swapfile'; \
    in-target bash -c 'echo "/swapfile none swap sw,pri=10 0 0" >> /etc/fstab'; \
    in-target bash -c 'echo "export LIBVIRT_DEFAULT_URI=qemu:///system" >> /home/lab/.bashrc'; \
    in-target bash -c 'echo "kvm_amd" > /etc/modules-load.d/kvm.conf'; \
    in-target sed -i 's/GRUB_CMDLINE_LINUX_DEFAULT="/GRUB_CMDLINE_LINUX_DEFAULT="quiet amd_iommu=on iommu=pt ipv6.disable=1 pcie_aspm=off /' /etc/default/grub; \
    in-target update-grub

d-i finish-install/reboot_in_progress note
d-i cdrom-detect/eject boolean true
